# e2e only: the scripted stand-in for Prometheus (test/e2e/fakeprom).
FROM docker.io/library/golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/fakeprom ./test/e2e/fakeprom

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/fakeprom /fakeprom
USER 65532:65532
ENTRYPOINT ["/fakeprom"]
